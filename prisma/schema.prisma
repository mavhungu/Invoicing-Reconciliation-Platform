generator client {
  provider     = "prisma-client"
  output       = "../apps/api/src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum AccountRole {
  owner
  accountant
  viewer
}

model Tenant {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
}

model User {
  id            String         @id @default(uuid()) @db.Uuid
  email         String         @unique
  passwordHash  String?
  displayName   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  memberships   Membership[]
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
}

model Membership {
  id        String      @id @default(uuid()) @db.Uuid
  tenantId  String      @db.Uuid
  userId    String      @db.Uuid
  role      AccountRole @default(viewer)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  tenant    Tenant      @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  user      User        @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tenantId, userId])
  @@index([userId])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  tenantId   String   @db.Uuid
  actorId    String   @db.Uuid
  action     String
  entityType String
  entityId   String
  before     Json?    @db.JsonB
  after      Json?    @db.JsonB
  timestamp  DateTime @default(now()) @db.Timestamptz(3)
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Restrict)
  actor      User     @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([tenantId, timestamp])
  @@index([tenantId, entityType, entityId])
  @@index([actorId])
}

model RefreshToken {
  id             String    @id @default(uuid()) @db.Uuid
  tokenHash      String    @unique
  familyId       String    @db.Uuid
  userId         String    @db.Uuid
  activeTenantId String    @db.Uuid
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  expiresAt      DateTime  @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  activeTenant   Tenant    @relation(fields: [activeTenantId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([familyId, revokedAt])
}
